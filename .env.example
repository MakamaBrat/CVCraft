# Скопіюйте цей файл у .env (локально) та в Vercel → Settings → Environment Variables

# ── Supabase (URL можна лишити з VITE_ префіксом — він не секретний) ───────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service-role ключ Supabase (Project Settings → API → service_role).
# СЕКРЕТНИЙ. Без префікса VITE_, тому Vite ніколи не покладе його у
# фронтенд-бандл. Використовується лише серверним кодом у /api.
# З цим ключем обходиться RLS — тримайте його тільки тут, ніколи не в коді.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram-бот ─────────────────────────────────────────────────────────
# Токен від @BotFather. Потрібен і для /api/bot.js (сповіщення),
# і для перевірки підпису initData у всіх /api-ендпоінтах.
TELEGRAM_BOT_TOKEN=

# https-адреса застосунку, напр. https://cvcraft.vercel.app
PUBLIC_APP_URL=

# Кома-розділений список Telegram ID адмінів, напр.: 111111111,222222222
# БЕЗ префікса VITE_ — це навмисно: список адмінів більше не потрапляє
# у фронтенд-бандл, перевіряється лише сервером у /api/admin.js.
ADMIN_TELEGRAM_IDS=
