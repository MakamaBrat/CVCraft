# Скопіюйте цей файл у .env та вставте свої дані з Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Кома-розділений список Telegram ID адмінів, напр.: 111111111,222222222
VITE_ADMIN_TELEGRAM_IDS=

# Той самий список потрібен і серверній частині (api/bot.js) для сповіщень
# про нові вакансії на модерацію — без префіксу VITE_
ADMIN_TELEGRAM_IDS=
# Токен бота для sendInvoice/answerPreCheckoutQuery (Telegram Stars)
BOT_TOKEN=
